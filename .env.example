# hpo-grid configuration — copy to .env (used by docker-compose env_file).
# All variables per SPEC section 2, with defaults shown.

# Go orchestrator
REDIS_ADDR=localhost:6379
API_ADDR=:8080
WORKER_IMAGE=hpo-grid/worker:latest
WORKER_REPLICAS=2
JOB_SHARD_SIZE=10

# Shared (Go / Clojure / Python worker)
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
GRID_ID=grid-0

# Python worker
WORKER_POLL_TIMEOUT_SEC=5
# Workers with JOB_ID empty iterate all jobs; set to pin a worker to one job.
JOB_ID=

# Clojure strategy engine
STRATEGY_EVAL_INTERVAL_SEC=10
STAGNATION_WINDOW=5

# Host-side published ports (used by docker-compose)
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
